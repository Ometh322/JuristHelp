# Конфигурация службы уведомлений jurist-notify
# Чтобы письма реально уходили, заполните SMTP_HOST/USER/PASS
# данными ящика info@pravo-standart.shop и перезапустите службу:
#   sudo systemctl restart jurist-notify
# Пока поля пусты, уведомления пишутся в NOTIFY_LOG.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@pravo-standart.shop
MAIL_TO=info@pravo-standart.shop

NOTIFY_PORT=8079
NOTIFY_LOG=/var/log/jurist-notify.log
